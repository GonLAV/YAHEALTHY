# YAHEALTHY Backend Configuration

# Server
PORT=5000
NODE_ENV=development

# Authentication
JWT_SECRET=your-super-secret-key-change-in-production

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key

# AI Provider (Optional - for real food photo estimation)
AI_PROVIDER=google-vision
AI_API_KEY=your-google-vision-api-key
AI_ENDPOINT=https://vision.googleapis.com/v1/images:annotate

# Places Provider (Optional - for real restaurant suggestions)
PLACES_PROVIDER=google-places
PLACES_API_KEY=your-google-places-api-key
PLACES_ENDPOINT=https://maps.googleapis.com/maps/api/place/nearbysearch/json

# Database
DB_POOL_SIZE=10
DB_TIMEOUT=30000

# Nuri + the chef on WhatsApp (routes/whapi.js) -- see migrations/001
WHAPI_API_URL=https://gate.whapi.cloud
WHAPI_TOKEN=your-whapi-channel-token
# Set the same value in the WHAPI dashboard's webhook custom headers
# (header name: X-Webhook-Secret). Skipped if unset -- fine for local
# testing only, required before the webhook is reachable from the internet.
WHAPI_WEBHOOK_SECRET=

ANTHROPIC_API_KEY=sk-ant-your-key
ANTHROPIC_MODEL=claude-sonnet-5
# Only needed if ANTHROPIC_API_KEY is an organization-scoped key rather than
# one scoped to a single workspace (Anthropic Console -> API Keys -> Scope).
# Org-scoped keys are rejected with a 400 until this names which workspace to
# bill -- find it under Workspaces (not the key's own ID), usually wrkspc_...
ANTHROPIC_WORKSPACE_ID=

# Required for whapi_conversations/whapi_messages: those two tables have RLS
# enabled with no policies (migrations/001), so the anon key above has no
# access to them. Supabase dashboard -> Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
