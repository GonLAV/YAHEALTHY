# YAHEALTHY backend — every environment variable the server reads.
# Copy to .env for local dev. Placeholders only: never commit real values.
# On boot, utils/config-check.js logs (names only) which optional features are
# off because their variable is missing, and in production (NODE_ENV=production)
# refuses to start when a REQUIRED one is missing.
#
# Legend: [required-prod] = boot fails in production without it
#         [optional]      = feature degrades/turns off; default in parentheses

# ── Server ────────────────────────────────────────────────────────────
# [optional] Port for app.listen (5000). Ignored on Vercel.
PORT=5000
# [required-prod] "production" turns on fail-fast checks and hides error details (development).
NODE_ENV=development
# [required-prod] Comma-separated browser origins allowed to call the API (dev: localhost:5173).
CORS_ORIGINS=http://localhost:5173
# [optional] Set automatically by Vercel; disables app.listen and the weekly-summary cron.
# VERCEL=1

# ── Auth ──────────────────────────────────────────────────────────────
# [required-prod] JWT signing secret; dev generates a throwaway one per boot. Use 32+ random bytes.
JWT_SECRET=change-me-to-a-long-random-string
# [optional] Requests to /api/auth/* per IP per 15 min (50). E2E raises it: every test shares one IP.
AUTH_RATE_LIMIT_MAX=50

# ── Database (Supabase) ───────────────────────────────────────────────
# [required-prod] Supabase project URL (unless ALLOW_MEMORY_DB=true outside production).
SUPABASE_URL=https://your-project.supabase.co
# [required-prod] Supabase anon/public key.
SUPABASE_KEY=your-anon-public-key
# [optional, needed in prod] service_role key for RLS-only tables (share_cards, whapi_*); falls back to anon key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# [optional] "true" = in-memory store when Supabase is unset (dev only; data lost on restart; refused in production).
ALLOW_MEMORY_DB=false

# ── Public URLs ───────────────────────────────────────────────────────
# [optional, set in prod] The web app's origin; used in email links and share-page CTAs (http://localhost:5173).
APP_URL=http://localhost:5173
# [optional] Where /s/:token share pages are public (APP_URL). If unset, the frontend host MUST forward ^/s/ to this backend.
SHARE_BASE_URL=
# [optional, set in prod] This API's public origin; PayPlus calls back to it (empty = no callback).
API_PUBLIC_URL=http://localhost:5000

# ── Email (password reset, weekly summary; lifecycle emails) ──
# [optional] SMTP connection string, e.g. smtps://user%40gmail.com:app-password@smtp.gmail.com:465 (unset = email off; prod refuses to send).
SMTP_URL=
# [optional] From address (the SMTP_URL username).
SMTP_FROM=
# [optional] Reserved for an API mail provider — not implemented; use SMTP_URL.
EMAIL_API_KEY=

# ── Pricing & payments (PayPlus) ──────────────────────────────────────
# Plan catalog: utils/plans.js. Each price is in NIS for one purchase of that plan
# (unset/0/garbage = "Price on request" on the landing page, checkout refuses that plan).
# Prices are a product decision — nothing is hard-coded. Owner has NOT confirmed them yet.
# [optional] App subscription, monthly.
PLAN_PRICE_APP_M=
# [optional] App subscription, yearly.
PLAN_PRICE_APP_Y=
# [optional] Chef (Yoni on WhatsApp) add-on, monthly.
PLAN_PRICE_CHEF_ADDON=
# [optional] Nutrition coaching, 3-month package.
PLAN_PRICE_COACHING_3M=
# [optional] Full combo (app + coaching + chef), 3 months.
PLAN_PRICE_COMBO_3M=
# [optional] One-time nutrition plan.
PLAN_PRICE_PLAN_ONCE=
# [deprecated] No longer read (the legacy base/yoni ids are aliases of coaching_3m/combo_3m); config-check warns if set.
PLAN_BASE_AMOUNT=
# [deprecated] No longer read; use PLAN_PRICE_COMBO_3M.
PLAN_YONI_AMOUNT=
# [optional] "true" turns online checkout on — ALSO needs CANCELLATION_POLICY_URL and the PayPlus keys (default off: checkout answers 503, the UI shows "Talk to us").
CHECKOUT_ENABLED=false
# [optional] Cancellation/refund policy page shown before paying (https://… or /path). Required for checkout.
CANCELLATION_POLICY_URL=
# [optional] Max PayPlus installments a buyer may choose, 2–36 (unset = single payment only). Verify in the PayPlus sandbox first.
PAYPLUS_MAX_INSTALLMENTS=
# [optional] "true" locks Premium features for people without the entitlement (default off: everything open, UI shows badges only).
ENTITLEMENTS_ENFORCED=false
# [optional] Free messages with Yoni (chef) on WhatsApp per number before the upsell, when enforced (5).
CHEF_FREE_TRIAL_MESSAGES=5
# [optional] "production" = live PayPlus; anything else = sandbox (sandbox).
PAYPLUS_ENV=sandbox
# [optional] PayPlus API key (unset = checkout disabled).
PAYPLUS_API_KEY=
# [optional] PayPlus secret key; also verifies callback signatures (unset = checkout disabled).
PAYPLUS_SECRET_KEY=
# [optional] PayPlus payment page UID (unset = checkout disabled).
PAYPLUS_PAYMENT_PAGE_UID=
# [optional] PayPlus status code meaning "approved" (000).
PAYPLUS_APPROVED_CODE=000

# ── Referrals (013) ───────────────────────────────────────────────────
# [optional] Premium days the referrer gets when an invited friend activates (logs within 7 days of signup) (14). Applied to users.premium_until.
REFERRAL_REWARD_DAYS=14
# [optional] Premium days the invited friend gets on that same activation (7; 0 = off). Not counted in the cap.
REFERRAL_FRIEND_REWARD_DAYS=7
# [optional] Max rewarded referrals per referrer (10).
REFERRAL_MAX_REWARDED=10
# [optional] Rate limit for public code validation, per IP per 15 min (30).
REFERRAL_VALIDATE_LIMIT=30

# ── Marketing leads (014) ─────────────────────────────────────────────
# [optional] Lead-form submissions per IP per 15 min (10).
LEAD_RATE_LIMIT_MAX=10

# ── Share cards (016) ─────────────────────────────────────────────────
# [optional] Share links a user may create per day (20).
SHARE_LINKS_PER_DAY=20
# [optional] Public /s/* and /api/share/c/* requests per IP per 15 min (300).
SHARE_PUBLIC_LIMIT=300

# ── Lifecycle messaging (018, utils/lifecycle*.js) ─────────────────────
# [optional] Set to false to stop the hourly job (it is always off on Vercel and under NODE_ENV=test).
LIFECYCLE_ENABLED=true
# [optional] Signs unsubscribe links (defaults to JWT_SECRET; rotating it breaks links in emails already sent).
LIFECYCLE_TOKEN_SECRET=
# [optional] Where unsubscribe links point, if the API is not reachable under APP_URL/api.
PUBLIC_API_URL=
# [optional] Unsubscribe/forget requests per IP per window (30).
UNSUBSCRIBE_RATE_LIMIT_MAX=30
# [optional] Scheduling knobs (defaults shown): default tz, quiet hours (no WhatsApp; email too unless
# LIFECYCLE_QUIET_HOURS_EMAIL=false) and the Shabbat guard (no sends Fri 16:00 - Sat 20:00 Israel time).
# LIFECYCLE_DEFAULT_TZ=Asia/Jerusalem
# LIFECYCLE_QUIET_START=22
# LIFECYCLE_QUIET_END=8
# LIFECYCLE_QUIET_HOURS_EMAIL=true
# LIFECYCLE_SHABBAT_GUARD=true
# LIFECYCLE_SHABBAT_START_HOUR=16
# LIFECYCLE_SHABBAT_END_HOUR=20

# ── WhatsApp: Adi + Yoni bot via WHAPI (routes/whapi.js) ───────────────
# [optional] WHAPI gateway (https://gate.whapi.cloud).
WHAPI_API_URL=https://gate.whapi.cloud
# [optional] WHAPI channel token (unset = bot cannot send).
WHAPI_TOKEN=
# [optional, needed in prod] X-Webhook-Secret header value; unset = webhook refused in production, open in dev.
WHAPI_WEBHOOK_SECRET=
# [optional] Anthropic API key for bot replies (unset = bot replies off).
ANTHROPIC_API_KEY=
# [optional] Model id (claude-sonnet-5).
ANTHROPIC_MODEL=claude-sonnet-5
# [optional] Only for organization-scoped keys: the workspace id to bill (wrkspc_...).
ANTHROPIC_WORKSPACE_ID=

# ── WhatsApp inbox (routes/whatsapp.js) ───────────────────────────────
# [optional, set in prod] Path secret for /api/whatsapp/webhook/:secret (unset = any secret accepted).
WHATSAPP_WEBHOOK_SECRET=

# ── Food database ingest (scripts/ingest-foods.js only) ───────────────
# [optional] USDA FoodData Central key (DEMO_KEY is heavily rate-limited).
USDA_API_KEY=

# ── Web Push / PWA reminders (020, utils/push.js) ─────────────────────
# [optional] VAPID keys; generate once with `npx web-push generate-vapid-keys`.
# Unset in development: a throwaway pair per boot (subscriptions break on restart). Unset in production: push off (503).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# [optional] Contact for push services.
VAPID_SUBJECT=mailto:support@example.com
# [optional] Extra push-service hosts to accept at subscribe time (comma separated).
PUSH_ALLOWED_HOSTS=
# [optional] Set to true to stop the 5-minute reminder scheduler in this process.
PUSH_REMINDERS_DISABLED=

# ── Observability (utils/logger.js, utils/error-tracker.js, /api/admin/health) ──
# [optional] Minimum log level: debug | info | warn | error (info; warn under NODE_ENV=test).
LOG_LEVEL=info
# [optional] json | pretty (json in production, pretty otherwise). JSON lines suit Vercel/log drains.
LOG_FORMAT=
# [optional] Sentry-compatible DSN (Sentry, self-hosted, GlitchTip). Unset = no error reports leave the server (default).
SENTRY_DSN=
# [optional] Environment tag on Sentry events (NODE_ENV).
SENTRY_ENVIRONMENT=
# [optional] Browser crash reports accepted per IP per 15 min at POST /api/client-errors (30).
CLIENT_ERROR_RATE_LIMIT_MAX=30
# [optional] Commit shown in /api/admin/health and used as the Sentry release. Vercel sets VERCEL_GIT_COMMIT_SHA itself;
# other hosts can set GIT_COMMIT_SHA at deploy time.
# VERCEL_GIT_COMMIT_SHA=
# GIT_COMMIT_SHA=

# ── Tests only (tests/*.test.js) ──────────────────────────────────────
# [optional] Port the suites bind their throwaway servers to (per-suite default).
# TEST_PORT=
