# YAHEALTHY frontend — environment variables (Vite). Placeholders only.
# VITE_* values are baked into the bundle at build time: never put a secret here.

# [optional] API origin prefixed to every /api call (src/services/api.ts). Empty (default) =
# same-origin relative paths: dev goes through the Vite proxy, production needs the host to
# rewrite /api/* (and ^/s/*) to the backend. Set to the backend origin (e.g.
# https://api.example.com) to call it directly — then add this site's origin to the
# backend's CORS_ORIGINS.
VITE_API_URL=

# [optional, dev server only] Where `vite dev` proxies /api and ^/s/ (http://localhost:5000;
# Docker: http://backend:5000). Read by vite.config.{js,ts}, not by the bundle.
VITE_PROXY_TARGET=http://localhost:5000

# Reserved: PWA / web push (020) is in progress and will likely add the public VAPID key here.
# VITE_VAPID_PUBLIC_KEY=
