# YAHEALTHY Backend Configuration

# Server
PORT=5000
NODE_ENV=development

# Authentication
JWT_SECRET=your-super-secret-key-change-in-production

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
# secret key (Project Settings -> API -> API Keys -> secret), NOT the
# publishable key: RLS on every table is deny-all, so only the secret key
# can read/write. This key bypasses all RLS -- never expose it to a
# browser or frontend, and never commit the real value (use .env, not
# this file, for the real value -- .env is gitignored).
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Only needed if the app ever adopts Supabase Auth (not used today --
# this backend verifies its own JWTs, see utils/auth.js).
# SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Required when Supabase isn't configured (local dev only) — without it the app
# crashes on startup instead of silently falling back to the in-memory DB
# ALLOW_MEMORY_DB=true

# AI Provider (Optional - for real food photo estimation)
AI_PROVIDER=google-vision
AI_API_KEY=your-google-vision-api-key
AI_ENDPOINT=https://vision.googleapis.com/v1/images:annotate

# Places Provider (Optional - for real restaurant suggestions)
PLACES_PROVIDER=google-places
PLACES_API_KEY=your-google-places-api-key
PLACES_ENDPOINT=https://maps.googleapis.com/maps/api/place/nearbysearch/json

# Database
DB_POOL_SIZE=10
DB_TIMEOUT=30000
