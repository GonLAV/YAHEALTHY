# YAHEALTHY Backend Configuration

# Server
PORT=5000
NODE_ENV=development

# Browser origins allowed to call this API, comma separated.
# Required in production - the server refuses to start without it.
CORS_ORIGINS=http://localhost:5173

# Authentication
JWT_SECRET=your-super-secret-key-change-in-production

# Where links in outbound email point - the app, not the API.
APP_URL=http://localhost:5173

# Email provider. Production refuses to send without one rather than
# dropping mail someone is waiting for. In development the reset link is
# printed to the server log instead.
SMTP_URL=
EMAIL_API_KEY=

# Supabase Configuration
# SUPABASE_KEY must be a SERVER key: the secret key (sb_secret_...) or the
# legacy service_role JWT. Every table has row level security on and no
# policies (migrations/001 onwards), so the public anon/publishable key can
# read and write nothing — sign-in, payments and meal plans would all fail.
# The server warns at startup if it recognises a public key here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-secret-server-key

# AI Provider (Optional - for real food photo estimation)
AI_PROVIDER=google-vision
AI_API_KEY=your-google-vision-api-key
AI_ENDPOINT=https://vision.googleapis.com/v1/images:annotate

# Places Provider (Optional - for real restaurant suggestions)
PLACES_PROVIDER=google-places
PLACES_API_KEY=your-google-places-api-key
PLACES_ENDPOINT=https://maps.googleapis.com/maps/api/place/nearbysearch/json

# Database
DB_POOL_SIZE=10
DB_TIMEOUT=30000

# ── Payments (PayPlus) ────────────────────────────────────────────────
# The hosted payment page. No card detail ever reaches this server.
# Leave PAYPLUS_ENV unset to stay on the sandbox: a misconfigured
# environment should take test money, not real money.
PAYPLUS_ENV=sandbox
PAYPLUS_API_KEY=
PAYPLUS_SECRET_KEY=
PAYPLUS_PAYMENT_PAGE_UID=

# Where PayPlus should call back to. Must be reachable from the internet.
API_PUBLIC_URL=http://localhost:5000

# Prices in NIS, set by the business owner. A plan with no price refuses to
# sell rather than taking nothing for something.
#   base — ליווי, without the chef
#   yoni — ליווי with Yoni, the chef
PLAN_BASE_AMOUNT=150
PLAN_YONI_AMOUNT=250
# Where a WhatsApp customer without the Yoni plan is sent to buy it
# (utils/yoni-gate.js). Empty means APP_URL + /pricing.
YONI_SIGNUP_URL=

# ── Booking: diagnosis (free) + supermarket session (paid) ────────────
# The one-time supermarket session — walking the aisles, what to buy. Empty
# or 0 means it is not offered.
SESSION_SUPERMARKET_AMOUNT=800
# Working hours, local time. Days: 0 = Sunday.
BOOKING_TIMEZONE=Asia/Jerusalem
BOOKING_DAYS=0,1,2,3,4
BOOKING_START=09:00
BOOKING_END=17:00
BOOKING_PHYSICAL_DURATION_MIN=45
BOOKING_ONLINE_DURATION_MIN=45
BOOKING_SUPERMARKET_DURATION_MIN=90
BOOKING_BUFFER_MIN=15
BOOKING_STEP_MIN=30
BOOKING_MIN_NOTICE_HOURS=12
BOOKING_HORIZON_DAYS=21
# How long an unpaid supermarket booking holds its time slot.
BOOKING_HOLD_MINUTES=30
# Where the physical diagnosis happens. Shown on the page and in the invite.
BOOKING_CLINIC_ADDRESS=

# ── Google Calendar (her calendar: busy times + new bookings + Meet) ──
# Get the refresh token once with: node scripts/google-auth.js
# Production refuses bookings until these are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# ── Scheduled jobs (vercel.json "crons") ──────────────────────────────
# Vercel sends it as "Authorization: Bearer <secret>". Unset = the reminder
# job refuses every call, including Vercel's.
CRON_SECRET=

# ── Food database ─────────────────────────────────────────────────────
# USDA FoodData Central. Free key, one minute:
#   https://fdc.nal.usda.gov/api-key-signup.html
# Used only by scripts/ingest-foods.js. DEMO_KEY works but allows about
# 30 requests an hour, which is not enough for the catalogue.
USDA_API_KEY=
# Nuri + the chef on WhatsApp (routes/whapi.js) -- see migrations/001
WHAPI_API_URL=https://gate.whapi.cloud
WHAPI_TOKEN=your-whapi-channel-token
# Set the same value in the WHAPI dashboard's webhook custom headers
# (header name: X-Webhook-Secret). Skipped if unset -- fine for local
# testing only, required before the webhook is reachable from the internet.
WHAPI_WEBHOOK_SECRET=

ANTHROPIC_API_KEY=sk-ant-your-key
ANTHROPIC_MODEL=claude-sonnet-5
# Only needed if ANTHROPIC_API_KEY is an organization-scoped key rather than
# one scoped to a single workspace (Anthropic Console -> API Keys -> Scope).
# Org-scoped keys are rejected with a 400 until this names which workspace to
# bill -- find it under Workspaces (not the key's own ID), usually wrkspc_...
ANTHROPIC_WORKSPACE_ID=

# Required for whapi_conversations/whapi_messages: those two tables have RLS
# enabled with no policies (migrations/001), so the anon key above has no
# access to them. Supabase dashboard -> Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
